---
// src/components/Card.astro
export interface Props {
    title: string;
    description: string;
    url: string;
    author?: string;
    date?: string;
}

const { title, description, url, author, date } = Astro.props;
---
<div class="bg-white p-6 rounded-lg border border-gray-200 shadow-sm hover:shadow-lg transition-shadow duration-300 flex flex-col h-full">
    <div class="flex-grow">
        <h3 class="text-xl font-bold text-gray-900 mb-2">{title}</h3>
        {author && date && <p class="text-sm text-gray-500 mb-4">By {author} on {date}</p>}
        <p class="text-gray-600">{description}</p>
    </div>
    <a href={url} class="mt-6 inline-block text-gray-800 font-semibold hover:text-gray-600 self-start">
        Read More &rarr;
    </a>
</div>