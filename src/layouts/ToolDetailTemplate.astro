
---
// Import required components and props
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

// Import global styles
import '../styles/global.css';

export interface Props {
	title: string;
	description: string;
  toolHeader: string;
  explainerText: string;
  promptTemplate: string;
  productLinks: Array<{ name: string; url: string }>;
}

const { title, description, toolHeader, explainerText, promptTemplate, productLinks } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-white text-gray-700 antialiased h-full flex">
        <Sidebar />
		<div class="flex flex-col grow">
			<main class="grow">
        <h1>{toolHeader}</h1>
        <div class="explainer-content">
          <Fragment set:html={explainerText} />
        </div>
        <section class="tool-prompt">
          <h2>Prompt Template</h2>
          <Fragment set:html={promptTemplate} />
        </section>
        <section class="tool-island">
          <slot name="tool-island" />
        </section>
        <section class="product-links">
          <h2>Related Products</h2>
          <ul>
            {productLinks.map((link) => (
              <li><a href={link.url}>{link.name}</a></li>
            ))}
          </ul>
        </section>
			</main>
			<Footer />
		</div>
	</body>
</html>
