
--- 
// src/layouts/ToolDetailTemplate.astro
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
---
<Layout title={frontmatter.title} description={frontmatter.description}>
    <div class="container mx-auto px-4 lg:px-6 py-8">
        <div class="max-w-3xl mx-auto">
            <header class="text-center mb-12">
                <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900">{frontmatter.title}</h1>
                {frontmatter.description && <p class="mt-4 text-lg text-gray-600">{frontmatter.description}</p>}
            </header>

            <div class="space-y-12">
                <!-- 1. Interactive Tool Element -->
                <section id="tool-element" class="bg-gray-50 p-6 rounded-lg border border-gray-200">
                    <h2 class="text-2xl font-semibold text-gray-900 mb-4">Add your data</h2>
                    <slot name="tool" />
                </section>

                <!-- 2. Explainer Section (Content from Markdown) -->
                <section id="explainer" class="prose lg:prose-xl max-w-none">
                    <h2 class="text-2xl font-semibold text-gray-900 mb-4">How It Works & Why It Matters</h2>
                    <slot />
                </section>

                <!-- 3. Dynamic LLM Prompt Block -->
                <section id="dynamic-llm-prompt" class="bg-blue-50 p-6 rounded-lg border border-blue-200">
                    <h3 class="text-xl font-semibold text-blue-800 mb-4">AI Prompt for Deeper Analysis</h3>
                    <p class="text-blue-700">Copy the prompt below and paste it into your favorite LLM (like ChatGPT or Claude) for a more detailed analysis based on your results.</p>
                    <pre class="mt-4 p-4 bg-blue-100 rounded-md text-blue-900 overflow-x-auto"><code id="llm-prompt-text">This is a placeholder for a dynamically generated LLM prompt.</code></pre>
                </section>

                <!-- 4. Affiliate Recommendations Section -->
                <section id="affiliate-recommendations" class="bg-white p-6 rounded-lg border border-gray-200">
                    <h2 class="text-2xl font-semibold text-gray-900 mb-4">Recommended Products</h2>
                    <p class="text-gray-600">This section will contain affiliate links to recommended products, likely managed via Markdown content or a data file.</p>
                    <div class="p-4 bg-gray-50 rounded-md border border-gray-200">
                        <p class="text-gray-700"><strong>Placeholder:</strong> Recommended affiliate product link goes here.</p>
                    </div>
                </section>
            </div>
        </div>
    </div>
</Layout>
