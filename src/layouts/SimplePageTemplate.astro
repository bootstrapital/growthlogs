
--- 
// src/layouts/SimplePageTemplate.astro
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
---
<Layout title={frontmatter.title} description={frontmatter.description}>
    <div class="container mx-auto px-4 lg:px-6 py-16">
        <div class="max-w-3xl mx-auto">
            <header class="text-center mb-12">
                <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900">{frontmatter.title}</h1>
                {frontmatter.description && <p class="mt-4 text-lg text-gray-600">{frontmatter.description}</p>}
            </header>
            <div class="prose lg:prose-xl max-w-none">
                <slot />
            </div>
        </div>
    </div>
</Layout>
