
--- 
// src/layouts/HomepageTemplate.astro
import Layout from './Layout.astro';
---
<Layout title="Growth Logs | Directory" description="A directory of tools, guides, experiments, and prompts.">
    <div class="p-8">
        <h1 class="text-4xl font-extrabold text-gray-900 mb-8">Content Directory</h1>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Tools</h2>
                <ul>
                    <li><a href="/tools/ab-test-calculator" class="text-gray-700 hover:text-indigo-600">A/B Test Calculator</a></li>
                    <li><a href="#" class="text-gray-700 hover:text-indigo-600">CAC Calculator</a></li>
                    <li><a href="#" class="text-gray-700 hover:text-indigo-600">LTV Calculator</a></li>
                </ul>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Guides</h2>
                <ul>
                    <li><a href="#" class="text-gray-700 hover:text-indigo-600">Example SaaS Tool Review</a></li>
                </ul>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Experiments</h2>
                <ul>
                    <li><a href="#" class="text-gray-700 hover:text-indigo-600">Example Experiment</a></li>
                </ul>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Prompts</h2>
                <ul>
                    <li><a href="#" class="text-gray-700 hover:text-indigo-600">Example Prompt</a></li>
                </ul>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Blog</h2>
                <ul>
                    <li><a href="#" class="text-gray-700 hover:text-indigo-600">Example Blog Post</a></li>
                </ul>
            </div>
        </div>
    </div>
</Layout>
