---
import ToolDetailTemplate from '../../layouts/ToolDetailTemplate.astro';
import CacExplainer from './explainer.md';
import CacPrompt from './prompt.md';
import CacLogicIsland from './CacLogicIsland.jsx';

const pageTitle = "Customer Acquisition Cost (CAC) Calculator";
const pageDescription = "Calculate your CAC to understand and optimize your marketing spend.";
const productLinks = [
  { name: "HubSpot CRM", url: "https://www.hubspot.com/crm" },
  { name: "Salesforce", url: "https://www.salesforce.com" },
];
---

<ToolDetailTemplate
  toolHeader={pageTitle}
  explainerText={CacExplainer.Content}
  promptTemplate={CacPrompt.Content}
  productLinks={productLinks}
>
  <CacLogicIsland client:load slot="tool-island" />
</ToolDetailTemplate>